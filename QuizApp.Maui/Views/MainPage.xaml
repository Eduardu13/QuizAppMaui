<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.Maui.Views.MainPage"
             Title="QuizApp">

    <Grid
        RowDefinitions="2*,*,*"
        ColumnDefinitions="Auto,*,Auto"
        Padding="5"
        RowSpacing="25"
        >

        <ImageButton
            Grid.Row="0"
            Grid.Column="0"
            Source="arrow_left_nav_icon.png"
            Command="{Binding Path=PreguntaSiguienteCommand}"
            
            />
        
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Background="LightGray"
            
            
            Margin="24"
            >
           

            <Label
                Text="{Binding Path=TextoDeLaPregunta}"
                FontSize="Medium"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                />

        </Border>

        <ImageButton
            Grid.Row="0"
            Grid.Column="2"
            Source="arrow_right_nav_icon.png"
            Command="{Binding Path=PreguntaAnteriorCommand}"
    
            />

        <HorizontalStackLayout
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            >
            
            <Label
                Text="{Binding Path=Resultado}"
                FontSize="Medium"
                />


        </HorizontalStackLayout>
        
        <HorizontalStackLayout
            Grid.Row="2"
            Grid.Column="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            
            Grid.ColumnSpan="6"
            Spacing="30"
            Margin="30"
            >
            

            <Button
                Text="Cierto"
                FontSize="Medium"
                MinimumWidthRequest="50"
                
                Command="{Binding Path=VerificaRespuestaEsCiertoCommand}"

                />

            <Button
                Text="Falso"
                FontSize="Medium"
                MinimumWidthRequest="50"
                
                Command="{Binding Path=VerificaRespuestaEsFalsoCommand}"

                />
        </HorizontalStackLayout>


    </Grid>
</ContentPage>